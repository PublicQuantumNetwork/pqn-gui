{
  "name": "material-ui-nextjs-ts",
  "version": "7.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:instance1": "dotenv -e .env.locala -- cross-env BUILD_DIR=.next-a next dev",
    "dev:instance2": "dotenv -e .env.localb -- cross-env BUILD_DIR=.next-b next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:files": "prettier --write",
    "test": "vitest run",
    "test:screens": "playwright test",
    "design:render": "node docs/design/halloween/render-design.mjs",
    "post-update": "echo \"codesandbox preview only, need an update\" && pnpm update --latest"
  },
  "dependencies": {
    "@emotion/cache": "latest",
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@mui/icons-material": "latest",
    "@mui/material": "latest",
    "@mui/material-nextjs": "latest",
    "dotenv-cli": "^10.0.0",
    "emoji-picker-react": "^4.15.0",
    "next": "^16.2.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "latest",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "typescript": "latest",
    "vitest": "^4.1.12"
  }
}
